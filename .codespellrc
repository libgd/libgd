[codespell]
ignore-words-list =
  acount,
  dout,
  inout,
  paeth,
skip =
  **/.deps/*,
  **/.libs/*,
  **/Makefile,
  **/Makefile.in,
  ./aclocal.m4,
  ./autom4te.cache/*,
  ./configure,
  ./config.cache,
  ./config.guess,
  ./config.h*,
  ./config.log,
  ./config.status,
  ./config/ar-lib,
  ./config/compile,
  ./config/config.guess,
  ./config/config.rpath,
  ./config/config.sub,
  ./config/depcomp,
  ./config/install-sh,
  ./config/ltmain.sh,
  ./config/missing,
  ./config/mkinstalldirs,
  ./config/test-driver,
  ./COPYING,
  ./depcomp,
  ./libtool,
  ./docs/INSTALL,
  ./m4/ax_*.m4,
  ./m4/libtool.m4,
  ./m4/lt*.m4,
  *~,
  *.[ao],
  *.l[ao],
  ./CONTRIBUTORS,
  ./src/entities.h,
  ./src/entities.html,
  **/*.avif,
  **/*.bmp,
  **/*.gd,
  **/*.gd2,
  **/*.gif,
  **/*.heic,
  **/*.jpg,
  **/*.jpeg,
  **/*.jxl,
  **/*.otf,
  **/*.png,
  **/*.qoi,
  **/*.tga,
  **/*.tif,
  **/*.tiff,
  **/*.ttf,
  **/*.webp,
  **/*.xbm,
  **/*.xpm,
